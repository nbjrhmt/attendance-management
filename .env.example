# ======================================================================
# 环境变量示例文件
# 使用方式：复制为 .env 后按实际环境修改（.env 不要提交到版本库）
#     Windows:  copy .env.example .env
#     Linux/macOS:  cp .env.example .env
# 说明：环境变量 > .env 文件 > 代码中的默认值
# ======================================================================

# ---------------------------- 应用基础配置 ----------------------------
APP_NAME=乡村基层活动智能签到管理平台
APP_VERSION=0.1.0
# 运行环境：development / testing / production
ENV=development
# 调试模式（true 时开启热重载与详细错误信息）
DEBUG=true
HOST=0.0.0.0
PORT=8000
# 业务接口统一前缀
API_PREFIX=/api
# 日志级别：CRITICAL / ERROR / WARNING / INFO / DEBUG
LOG_LEVEL=INFO

# ------------------------------ MySQL --------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123456
DB_NAME=attendance
DB_CHARSET=utf8mb4
# 是否打印 SQL 语句（开发排查时设为 true）
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
# 可选：直接指定完整连接串，配置后优先生效（忽略上面的分项配置）
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/attendance?charset=utf8mb4

# ------------------------------- Redis -------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 无密码时留空
REDIS_PASSWORD=
REDIS_KEY_PREFIX=attendance:
# 可选：直接指定完整连接串，配置后优先生效
# REDIS_URL=redis://127.0.0.1:6379/0

# -------------------------------- JWT --------------------------------
# 生产环境务必替换为足够随机的长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------- CORS -------------------------------
# 多个来源用英文逗号分隔；* 表示允许所有来源（生产环境不建议）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# -------------------------- 百度 AI 人脸识别 --------------------------
# 在百度智能云控制台创建"人脸识别"应用后获取
# 人脸识别提供方：baidu 使用百度 AI 人脸库；local 为本地模式
# 说明：local 模式不调用外部服务、不做人脸比对（仅记录照片与录入状态），
#       供未申请到百度密钥时前端联调使用；生产环境（ENV=production）禁止使用 local
FACE_PROVIDER=baidu
BAIDU_FACE_API_KEY=
BAIDU_FACE_SECRET_KEY=
# 人脸库（用户组）标识
BAIDU_FACE_GROUP_ID=attendance_family
# 人脸比对通过阈值（0-100，分数越高越严格）
FACE_MATCH_THRESHOLD=80
# 人脸照片存储目录（相对项目根目录，已加入 .gitignore）
FACE_UPLOAD_DIR=uploads/face
# 单张人脸照片大小上限（MB）
FACE_MAX_IMAGE_MB=2
# 搜索时最多返回的候选数量
FACE_SEARCH_MAX_CANDIDATES=5
# 录入人脸前是否先做一次人脸检测（拒绝无人脸 / 多张人脸的照片）
FACE_DETECT_ON_REGISTER=true
# 百度 access_token 提前刷新余量（秒）
BAIDU_FACE_TOKEN_REFRESH_MARGIN=3600

# ----------------------------- 业务参数 -------------------------------
# 创建活动时未指定迟到阈值所使用的默认值（分钟）
DEFAULT_LATE_THRESHOLD_MINUTES=15

# --------------------------- AI 智能助手（LLM） ------------------------
# 提供方：mock 无需密钥即可跑通全流程（默认，回答为模板化提示）；
#         openai_compat 调用任意 OpenAI 兼容接口（DeepSeek / 豆包 / 通义 等）
LLM_PROVIDER=mock
# OpenAI 兼容服务地址（不要带 /chat/completions，程序会自动拼接）
# DeepSeek：https://api.deepseek.com/v1   豆包（方舟）：https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=
# 服务商 API Key（放在 .env 中，.env 已被 gitignore，不要提交到版本库）
LLM_API_KEY=
# 模型名称：deepseek-chat / doubao-pro-32k / qwen-plus 等
LLM_MODEL=
# 单次 LLM 请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 单轮对话内最多允许的工具调用轮数（超过则强制停止并告知用户）
AI_TOOL_MAX_ROUNDS=4
# 轻量 RAG：注入系统提示词的知识库 Q&A 条数
AI_KNOWLEDGE_TOP_K=3
